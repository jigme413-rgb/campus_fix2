PORT=3000
NODE_ENV=development

# postgres://USER:PASSWORD@HOST:PORT/DATABASE
# `npm run db:setup` creates this database if it does not exist yet.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/campusfix
# Set to true on Render (managed Postgres requires SSL)
DB_SSL=false

# Use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Admin account created by `npm run db:setup`
ADMIN_EMAIL=admin@sherubtse.edu.bt
ADMIN_PASSWORD=Admin@123
