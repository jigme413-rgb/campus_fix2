<%# One linked segment per lifecycle stage. Segment width follows its share of the total. %>
<% const railTotal = STATUSES.reduce((sum, s) => sum + (counts[s] || 0), 0); %>
<nav class="status-rail" aria-label="Requests by status">
  <% STATUSES.forEach((s) => { const n = counts[s] || 0; %>
    <a class="rail-seg rail-<%= slug(s) %>" href="<%= qs('/requests', { status: s }) %>" style="--share: <%= railTotal ? Math.max(n / railTotal, 0.08).toFixed(3) : 0.25 %>">
      <span class="rail-count"><%= n %></span>
      <span class="rail-label"><%= s %></span>
    </a>
  <% }) %>
</nav>
