<li class="request-item">
  <a href="/requests/<%= r.id %>" class="request-link">
    <span class="cat-icon cat-<%= slug(r.category_name) %>" title="<%= r.category_name || 'Uncategorised' %>"><%- icon(categoryIcon(r.category_name)) %></span>
    <span class="request-main">
      <span class="request-title"><%= r.title %></span>
      <span class="request-meta">
        <span class="request-id">#<%= r.id %></span>
        <span><%- icon('pin') %><%= r.location %></span>
        <span><%- icon('clock') %><%= timeAgo(r.created_at) %></span>
        <% if (locals.showPeople && r.assigned_name) { %><span><%- icon('wrench') %><%= r.assigned_name %></span><% } %>
        <% if (locals.showReporter) { %><span><%- icon('user') %><%= r.reporter_name %></span><% } %>
      </span>
    </span>
    <span class="request-side">
      <span class="request-badges">
        <%- include('priority', { priority: r.priority }) %>
        <span class="status-text status-<%= slug(r.status) %>"><%= r.status %></span>
      </span>
      <%- include('track', { status: r.status }) %>
    </span>
  </a>
</li>
