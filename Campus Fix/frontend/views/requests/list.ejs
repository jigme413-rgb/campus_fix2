<%- include('../partials/top') %>
<% const isAdmin = user.role === 'admin'; const isReporter = user.role === 'student' || user.role === 'staff'; %>

<div class="page-head">
  <div>
    <h1><%= title %></h1>
    <p class="muted"><%= plural(list.total, 'request') %><%= Object.keys(filters).some((k) => k !== 'page' && k !== 'sort') ? ' match your filters' : '' %></p>
  </div>
  <% if (isReporter) { %><a class="btn btn-primary" href="/requests/new"><%- icon('plus') %> Report a problem</a><% } %>
</div>

<form class="filters card" method="get" action="/requests" role="search" data-autosubmit>
  <div class="field search-field">
    <label for="search" class="sr-only">Search</label>
    <%- icon('search') %>
    <input id="search" name="search" type="search" placeholder="Search title, description or location" value="<%= filters.search || '' %>">
  </div>
  <div class="field">
    <label for="f-status">Status</label>
    <select id="f-status" name="status">
      <option value="">Any</option>
      <% STATUSES.forEach((s) => { %><option <%= filters.status === s ? 'selected' : '' %>><%= s %></option><% }) %>
    </select>
  </div>
  <div class="field">
    <label for="f-priority">Priority</label>
    <select id="f-priority" name="priority">
      <option value="">Any</option>
      <% PRIORITIES.forEach((p) => { %><option <%= filters.priority === p ? 'selected' : '' %>><%= p %></option><% }) %>
    </select>
  </div>
  <div class="field">
    <label for="f-category">Category</label>
    <select id="f-category" name="category_id">
      <option value="">Any</option>
      <% categories.forEach((c) => { %><option value="<%= c.id %>" <%= filters.category_id == c.id ? 'selected' : '' %>><%= c.name %></option><% }) %>
    </select>
  </div>
  <% if (isAdmin) { %>
    <div class="field">
      <label for="f-staff">Assigned to</label>
      <select id="f-staff" name="assigned_to">
        <option value="">Anyone</option>
        <% staff.forEach((s) => { %><option value="<%= s.id %>" <%= filters.assigned_to == s.id ? 'selected' : '' %>><%= s.name %></option><% }) %>
      </select>
    </div>
  <% } %>
  <div class="field">
    <label for="f-sort">Sort</label>
    <select id="f-sort" name="sort">
      <% [['newest','Newest first'],['oldest','Oldest first'],['priority','Most urgent'],['updated','Recently updated']].forEach(([v, l]) => { %>
        <option value="<%= v %>" <%= (filters.sort || 'newest') === v ? 'selected' : '' %>><%= l %></option>
      <% }) %>
    </select>
  </div>
  <div class="filter-actions">
    <button class="btn btn-primary btn-sm" type="submit">Apply</button>
    <a class="btn btn-ghost btn-sm" href="/requests">Clear</a>
  </div>
</form>

<% if (list.requests.length) { %>
  <ul class="request-list card">
    <% list.requests.forEach((r) => { %><%- include('../partials/request-item', { r, showPeople: !isReporter, showReporter: !isReporter }) %><% }) %>
  </ul>
  <%- include('../partials/pagination') %>
<% } else { %>
  <div class="empty-state card">
    <%- icon('search', 'icon-lg') %>
    <h2>No requests found</h2>
    <p class="muted">
      <% if (Object.keys(filters).length) { %>Try removing a filter.<% } else if (isReporter) { %>When you report a problem it will appear here.<% } else { %>Nothing here yet.<% } %>
    </p>
  </div>
<% } %>

<%- include('../partials/bottom') %>
