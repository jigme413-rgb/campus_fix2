<%- include('../partials/top') %>
<% const steps = STATUSES; const currentStep = steps.indexOf(request.status); %>

<a class="back-link" href="/requests"><%- icon('arrowLeft') %> All requests</a>

<div class="page-head">
  <div>
    <h1><%= request.title %></h1>
    <div class="request-badges">
      <span class="request-id">#<%= request.id %></span>
      <%- include('../partials/status', { status: request.status }) %>
      <%- include('../partials/priority', { priority: request.priority }) %>
    </div>
  </div>
  <% if (can.edit) { %>
    <a class="btn btn-ghost" href="/requests/<%= request.id %>/edit"><%- icon('edit') %> Edit</a>
  <% } %>
</div>

<ol class="progress" aria-label="Progress">
  <% steps.forEach((s, i) => { %>
    <li class="<%= i < currentStep ? 'done' : i === currentStep ? 'current' : '' %>" <%- i === currentStep ? 'aria-current="step"' : '' %>>
      <span class="progress-dot"><%- i < currentStep ? icon('check') : i + 1 %></span>
      <span><%= s %></span>
    </li>
  <% }) %>
</ol>

<div class="two-col">
  <div class="stack">
    <section class="card">
      <h2 class="sr-only">Details</h2>
      <p class="description"><%= request.description %></p>
      <dl class="facts">
        <div><dt><%- icon('pin') %> Location</dt><dd><%= request.location %></dd></div>
        <div><dt><%- icon(categoryIcon(request.category_name)) %> Category</dt><dd><%= request.category_name || 'Uncategorised' %></dd></div>
        <div><dt><%- icon('user') %> Reported by</dt><dd><%= request.reporter_name %></dd></div>
        <div><dt><%- icon('wrench') %> Assigned to</dt><dd><%= request.assigned_name || 'Not yet assigned' %></dd></div>
        <div><dt><%- icon('clock') %> Reported</dt><dd><%= dateTime(request.created_at) %></dd></div>
        <div><dt><%- icon('check') %> Completed</dt><dd><%= request.completed_at ? dateTime(request.completed_at) : '-' %></dd></div>
      </dl>
    </section>

    <section class="card">
      <h2>History</h2>
      <ol class="timeline">
        <% history.slice().reverse().forEach((h) => { %>
          <li>
            <span class="timeline-dot status-<%= slug(h.new_status) %>" aria-hidden="true"></span>
            <div>
              <p>
                <% if (h.old_status) { %><%= h.old_status %> <%- icon('arrowRight', 'icon-sm') %> <% } %>
                <strong><%= h.new_status %></strong>
                <% if (h.changed_by_name) { %><span class="muted">by <%= h.changed_by_name %></span><% } %>
              </p>
              <% if (h.note) { %><p class="timeline-note"><%= h.note %></p><% } %>
              <time class="muted small" datetime="<%= new Date(h.changed_at).toISOString() %>"><%= dateTime(h.changed_at) %></time>
            </div>
          </li>
        <% }) %>
      </ol>
    </section>
  </div>

  <aside class="stack">
    <% if (can.advance) { %>
      <section class="card action-card">
        <h2>Update progress</h2>
        <form method="post" action="/requests/<%= request.id %>/status" class="stack-form">
          <input type="hidden" name="status" value="<%= can.advance %>">
          <div class="field">
            <label for="note">Note <span class="muted">(optional)</span></label>
            <textarea id="note" name="note" rows="2" maxlength="500" placeholder="<%= can.advance === 'Completed' ? 'What was done?' : 'e.g. Ordered a replacement part' %>"></textarea>
          </div>
          <button class="btn btn-primary btn-block" type="submit"><%- icon(can.advance === 'Completed' ? 'check' : 'wrench') %> Mark as <%= can.advance %></button>
        </form>
      </section>
    <% } %>

    <% if (can.assign) { %>
      <section class="card action-card">
        <h2><%= request.assigned_to ? 'Reassign' : 'Assign to staff' %></h2>
        <% if (staff.length) { %>
          <form method="post" action="/requests/<%= request.id %>/assign" class="stack-form">
            <div class="field">
              <label for="staff_id">Maintenance staff</label>
              <select id="staff_id" name="staff_id" required>
                <option value="">Choose someone</option>
                <% staff.forEach((s) => { %>
                  <option value="<%= s.id %>" <%= request.assigned_to === s.id ? 'selected' : '' %>><%= s.name %> (<%= plural(s.open_assignments, 'open job') %>)</option>
                <% }) %>
              </select>
            </div>
            <button class="btn btn-primary btn-block" type="submit"><%- icon('user') %> Assign</button>
          </form>
        <% } else { %>
          <p class="muted small">No maintenance staff accounts yet. <a href="/admin/users">Create one</a>.</p>
        <% } %>
      </section>
    <% } %>

    <% if (can.setAnyStatus) { %>
      <section class="card action-card">
        <h2>Change status</h2>
        <form method="post" action="/requests/<%= request.id %>/status" class="stack-form">
          <div class="field">
            <label for="status">New status</label>
            <select id="status" name="status">
              <% STATUSES.filter((s) => s !== request.status).forEach((s) => { %><option><%= s %></option><% }) %>
            </select>
          </div>
          <div class="field">
            <label for="admin-note">Note <span class="muted">(optional)</span></label>
            <input id="admin-note" name="note" maxlength="500" placeholder="Reason for the change">
          </div>
          <button class="btn btn-ghost btn-block" type="submit">Update status</button>
        </form>
      </section>
    <% } %>

    <% if (can.remove) { %>
      <form method="post" action="/requests/<%= request.id %>/delete" data-confirm="Delete request #<%= request.id %>? This cannot be undone.">
        <button class="btn btn-danger btn-block" type="submit"><%- icon('trash') %> Delete request</button>
      </form>
    <% } %>

    <% if (!can.advance && !can.assign && !can.remove) { %>
      <section class="card muted-card">
        <h2>What happens next?</h2>
        <p class="muted small">
          <% if (request.status === 'Pending') { %>The maintenance office will assign this to a staff member. You will get a notification.
          <% } else if (request.status === 'Assigned') { %><%= request.assigned_name %> will start work soon.
          <% } else if (request.status === 'In Progress') { %><%= request.assigned_name %> is working on it.
          <% } else { %>This problem has been fixed. If it comes back, report it again.<% } %>
        </p>
      </section>
    <% } %>
  </aside>
</div>

<%- include('../partials/bottom') %>
