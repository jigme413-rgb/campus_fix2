<%- include('../partials/top') %>

<div class="page-head">
  <div>
    <h1>Categories</h1>
    <p class="muted">Reporters choose one of these when submitting a request.</p>
  </div>
</div>

<div class="two-col wide-left">
  <section class="card">
    <ul class="category-admin">
      <% categories.forEach((c) => { %>
        <li>
          <span class="cat-icon cat-<%= slug(c.name) %>"><%- icon(categoryIcon(c.name)) %></span>
          <form method="post" action="/admin/categories/<%= c.id %>" class="inline-form grow">
            <label class="sr-only" for="cat-<%= c.id %>">Name</label>
            <input id="cat-<%= c.id %>" name="name" value="<%= c.name %>" maxlength="50" required>
            <button class="btn btn-ghost btn-sm" type="submit">Rename</button>
          </form>
          <a class="count-pill" href="<%= qs('/requests', { category_id: c.id }) %>" title="Requests in this category"><%= c.request_count %></a>
          <form method="post" action="/admin/categories/<%= c.id %>/delete" data-confirm="Delete the &quot;<%= c.name %>&quot; category? Its <%= c.request_count %> request(s) will become uncategorised.">
            <button class="icon-btn danger" type="submit" aria-label="Delete <%= c.name %>"><%- icon('trash') %></button>
          </form>
        </li>
      <% }) %>
    </ul>
  </section>

  <aside class="card">
    <h2>Add a category</h2>
    <form method="post" action="/admin/categories" class="stack-form">
      <div class="field">
        <label for="name">Name</label>
        <input id="name" name="name" maxlength="50" required placeholder="e.g. Sports Ground">
      </div>
      <button class="btn btn-primary btn-block" type="submit"><%- icon('plus') %> Add category</button>
    </form>
  </aside>
</div>

<%- include('../partials/bottom') %>
