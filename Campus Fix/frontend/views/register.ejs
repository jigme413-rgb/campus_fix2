<%- include('partials/top') %>

<div class="auth card">
  <h1>Create account</h1>
  <p class="muted">For Sherubtse students and college staff. Maintenance accounts are created by the administrator.</p>

  <% if (error) { %>
    <div class="form-error" role="alert"><%- icon('alert') %> <%= error %></div>
  <% } %>

  <form method="post" action="/register" class="stack-form" novalidate>
    <div class="field <%= errors.name ? 'has-error' : '' %>">
      <label for="name">Full name</label>
      <input id="name" name="name" autocomplete="name" required value="<%= values.name || '' %>" <%- errors.name ? 'aria-invalid="true" aria-describedby="name-error"' : '' %>>
      <% if (errors.name) { %><p class="field-error" id="name-error"><%= errors.name %></p><% } %>
    </div>
    <div class="field <%= errors.email ? 'has-error' : '' %>">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="email" required value="<%= values.email || '' %>" <%- errors.email ? 'aria-invalid="true" aria-describedby="email-error"' : '' %>>
      <% if (errors.email) { %><p class="field-error" id="email-error"><%= errors.email %></p><% } %>
    </div>
    <fieldset class="field segmented">
      <legend>I am a</legend>
      <label><input type="radio" name="role" value="student" <%= values.role !== 'staff' ? 'checked' : '' %>> Student</label>
      <label><input type="radio" name="role" value="staff" <%= values.role === 'staff' ? 'checked' : '' %>> Lecturer / staff</label>
    </fieldset>
    <div class="field <%= errors.password ? 'has-error' : '' %>">
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="new-password" required aria-describedby="password-hint<%= errors.password ? ' password-error' : '' %>">
      <p class="hint" id="password-hint">At least 8 characters, with a letter and a number.</p>
      <% if (errors.password) { %><p class="field-error" id="password-error"><%= errors.password %></p><% } %>
    </div>
    <div class="field <%= errors.confirmPassword ? 'has-error' : '' %>">
      <label for="confirmPassword">Confirm password</label>
      <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" required>
      <% if (errors.confirmPassword) { %><p class="field-error"><%= errors.confirmPassword %></p><% } %>
    </div>
    <button class="btn btn-primary btn-block" type="submit">Create account</button>
  </form>

  <p class="auth-switch">Already registered? <a href="/login">Log in</a></p>
</div>

<%- include('partials/bottom') %>
