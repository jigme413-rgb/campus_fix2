<%- include('partials/top') %>

<div class="page-head">
  <div>
    <h1>Notifications</h1>
    <p class="muted"><%= unread ? `${unread} unread` : 'You are all caught up.' %></p>
  </div>
  <% if (unread) { %>
    <form method="post" action="/notifications/read-all">
      <button class="btn btn-ghost" type="submit"><%- icon('check') %> Mark all as read</button>
    </form>
  <% } %>
</div>

<% if (notifications.length) { %>
  <ul class="note-list card">
    <% notifications.forEach((n) => { %>
      <li class="<%= n.is_read ? '' : 'unread' %>">
        <form method="post" action="/notifications/<%= n.id %>/open">
          <button type="submit" class="note-btn">
            <span class="note-type type-<%= slug(n.type) %>"><%- icon(n.type === 'requestCompleted' ? 'check' : n.type === 'requestAssigned' ? 'user' : n.type === 'maintenanceRequestCreated' ? 'plus' : 'wrench') %></span>
            <span class="note-body">
              <span><%= n.message %></span>
              <small class="muted"><%= timeAgo(n.created_at) %></small>
            </span>
            <% if (!n.is_read) { %><span class="sr-only">(unread)</span><% } %>
          </button>
        </form>
      </li>
    <% }) %>
  </ul>
<% } else { %>
  <div class="empty-state card">
    <%- icon('bell', 'icon-lg') %>
    <h2>No notifications yet</h2>
    <p class="muted">Updates about your requests will show up here.</p>
  </div>
<% } %>

<%- include('partials/bottom') %>
