<%- include('partials/top') %>

<section class="hero">
  <div class="hero-text">
    <h1>Report it once.<br>Watch it get fixed.</h1>
    <p class="lead">Tell the maintenance office about a broken light, a leaking tap or dead Wi-Fi, then follow every step until it is done.</p>
    <div class="hero-actions">
      <a class="btn btn-primary btn-lg" href="/register"><%- icon('plus') %> Report a problem</a>
    </div>
  </div>

  <%# A real request card built from the same partials the app uses, filled with sample data %>
  <figure class="preview" aria-label="Example of a tracked request">
    <div class="preview-card">
      <div class="preview-head">
        <span class="cat-icon cat-electrical"><%- icon('bolt') %></span>
        <div>
          <p class="preview-title">Tube light flickering in Lecture Hall 3</p>
          <p class="request-meta"><span class="request-id">#41</span><span><%- icon('pin') %>Academic Block A</span></p>
        </div>
        <%- include('partials/priority', { priority: 'High' }) %>
      </div>
      <div class="preview-track">
        <%- include('partials/track', { status: 'In Progress' }) %>
        <div class="preview-steps" aria-hidden="true"><% STATUSES.forEach((s) => { %><span><%= s %></span><% }) %></div>
      </div>
      <ol class="timeline preview-timeline">
        <li><span class="timeline-dot status-in-progress" aria-hidden="true"></span><div><p><strong>In Progress</strong> <span class="muted">by Karma Wangdi</span></p><p class="timeline-note">Replacing the starter and both tubes.</p></div></li>
        <li><span class="timeline-dot status-assigned" aria-hidden="true"></span><div><p><strong>Assigned</strong> <span class="muted">to Karma Wangdi</span></p></div></li>
        <li><span class="timeline-dot status-pending" aria-hidden="true"></span><div><p><strong>Pending</strong> <span class="muted">reported by Tashi Dorji</span></p></div></li>
      </ol>
    </div>
  </figure>
</section>

<section class="roles" aria-labelledby="roles-heading">
  <h2 id="roles-heading" class="section-title">One record, three people who need it</h2>

  <article class="role role-reporter">
    <div>
      <h3>Students and lecturers</h3>
      <p>Pick what broke, say where it is, and choose how urgent it feels. You are notified at every step, so nobody has to report the same fault twice.</p>
    </div>
    <div class="role-block">
      <p class="role-label">What you can report</p>
      <ul class="chip-row">
        <% ['Electrical','Plumbing','Wi-Fi','Furniture','Hostel','Cleaning'].forEach((name) => { %>
          <li class="chip"><span class="cat-icon cat-<%= slug(name) %>"><%- icon(categoryIcon(name)) %></span><%= name %></li>
        <% }) %>
      </ul>
    </div>
    <div class="role-block">
      <p class="role-label">How urgent it is</p>
      <ul class="priority-scale">
        <li><%- include('partials/priority', { priority: 'Low' }) %>Can wait for routine work</li>
        <li><%- include('partials/priority', { priority: 'Medium' }) %>Inconvenient</li>
        <li><%- include('partials/priority', { priority: 'High' }) %>Stops a class or room</li>
        <li><%- include('partials/priority', { priority: 'Urgent' }) %>Safety risk</li>
      </ul>
    </div>
  </article>

  <article class="role role-staff">
    <span class="role-icon"><%- icon('hammer') %></span>
    <h3>Maintenance staff</h3>
    <p>A queue of your own jobs, most urgent first. Move each one to In Progress, then Completed, with a note on what you did.</p>
  </article>

  <article class="role role-office">
    <span class="role-icon"><%- icon('buildings') %></span>
    <h3>The maintenance office</h3>
    <p>Assign work by current load, see which buildings keep breaking, and know how long repairs really take.</p>
  </article>
</section>

<%- include('partials/bottom') %>
