{
  "info": {
    "name": "CampusFix API",
    "description": "Every CampusFix endpoint, ordered as the proposal's event flow (section 8.1). Run the whole collection with the Collection Runner: logins store tokens in collection variables and the created request id is reused by later steps. Requires `npm run db:setup` demo data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "studentToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "staffToken", "value": "" },
    { "key": "staffId", "value": "" },
    { "key": "requestId", "value": "" },
    { "key": "categoryId", "value": "1" }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "GET /health",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/health" }
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register a student (201)",
          "event": [
            { "listen": "prerequest", "script": { "exec": ["pm.collectionVariables.set('newEmail', `postman.${Date.now()}@sherubtse.edu.bt`);"] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('returns token, no password hash', () => { const b = pm.response.json(); pm.expect(b.token).to.be.a('string'); pm.expect(b.user.password_hash).to.be.undefined; });"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Student\",\n  \"email\": \"{{newEmail}}\",\n  \"password\": \"Password1\",\n  \"role\": \"student\"\n}" }
          }
        },
        {
          "name": "Register with invalid data (400)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
            "pm.test('field details', () => pm.expect(pm.response.json().error.details).to.be.an('array').that.is.not.empty);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"X\",\n  \"email\": \"not-an-email\",\n  \"password\": \"123\"\n}" }
          }
        },
        {
          "name": "Login as student",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('studentToken', pm.response.json().token);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"student@sherubtse.edu.bt\",\n  \"password\": \"Student@123\"\n}" }
          }
        },
        {
          "name": "Login as admin",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('adminToken', pm.response.json().token);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@sherubtse.edu.bt\",\n  \"password\": \"Admin@123\"\n}" }
          }
        },
        {
          "name": "Login as maintenance staff",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.collectionVariables.set('staffToken', b.token);",
            "pm.collectionVariables.set('staffId', b.user.id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"electrician@sherubtse.edu.bt\",\n  \"password\": \"Maint@123\"\n}" }
          }
        },
        {
          "name": "Login with wrong password (401)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"student@sherubtse.edu.bt\",\n  \"password\": \"WrongPass1\"\n}" }
          }
        },
        {
          "name": "GET /auth/me",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }], "url": "{{baseUrl}}/auth/me" }
        }
      ]
    },
    {
      "name": "2. Request workflow (event flow 8.1)",
      "item": [
        {
          "name": "List categories",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const electrical = pm.response.json().categories.find(c => c.name === 'Electrical');",
            "if (electrical) pm.collectionVariables.set('categoryId', electrical.id);"
          ] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }], "url": "{{baseUrl}}/categories" }
        },
        {
          "name": "T1 Submit a valid request (201, emits maintenanceRequestCreated)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "const r = pm.response.json().request;",
            "pm.test('status is Pending', () => pm.expect(r.status).to.eql('Pending'));",
            "pm.collectionVariables.set('requestId', r.id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/requests",
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Broken classroom light\",\n  \"description\": \"The tube light at the front of Room 101 does not switch on.\",\n  \"location\": \"Academic Block A, Room 101\",\n  \"category_id\": {{categoryId}},\n  \"priority\": \"High\"\n}" }
          }
        },
        {
          "name": "T2 Submit without a title (400)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
            "pm.test('title error', () => pm.expect(pm.response.json().error.details.map(d => d.field)).to.include('title'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/requests",
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"\",\n  \"description\": \"Missing title test\",\n  \"location\": \"Library\",\n  \"category_id\": {{categoryId}}\n}" }
          }
        },
        {
          "name": "T3 List requests without a token (401)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/requests" }
        },
        {
          "name": "Student lists own requests",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }], "url": "{{baseUrl}}/requests" }
        },
        {
          "name": "Student edits request while Pending (PUT)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/requests/{{requestId}}",
            "body": { "mode": "raw", "raw": "{\n  \"priority\": \"Urgent\"\n}" }
          }
        },
        {
          "name": "T4 Student tries to assign (403)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('403 Forbidden', () => pm.response.to.have.status(403));"] } }],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/requests/{{requestId}}/assign",
            "body": { "mode": "raw", "raw": "{\n  \"staff_id\": {{staffId}}\n}" }
          }
        },
        {
          "name": "Admin filters and searches all requests",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/requests?status=Pending&search=light&sort=priority", "host": ["{{baseUrl}}"], "path": ["requests"], "query": [{ "key": "status", "value": "Pending" }, { "key": "search", "value": "light" }, { "key": "sort", "value": "priority" }] }
          }
        },
        {
          "name": "T5 Admin assigns to staff (emits requestAssigned)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('status Assigned', () => pm.expect(pm.response.json().request.status).to.eql('Assigned'));"
          ] } }],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/requests/{{requestId}}/assign",
            "body": { "mode": "raw", "raw": "{\n  \"staff_id\": {{staffId}}\n}" }
          }
        },
        {
          "name": "Staff starts work: In Progress (emits requestStatusUpdated)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/requests/{{requestId}}/status",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"In Progress\",\n  \"note\": \"Replacing the starter\"\n}" }
          }
        },
        {
          "name": "T6 Staff marks Completed (emits requestCompleted)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('status Completed', () => pm.expect(pm.response.json().request.status).to.eql('Completed'));"
          ] } }],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/requests/{{requestId}}/status",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"Completed\"\n}" }
          }
        },
        {
          "name": "T8 View request with full status history",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('4 history rows', () => pm.expect(pm.response.json().history.length).to.eql(4));"
          ] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }], "url": "{{baseUrl}}/requests/{{requestId}}" }
        },
        {
          "name": "Student sees the completion notification",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('latest is requestCompleted', () => pm.expect(pm.response.json().notifications[0].type).to.eql('requestCompleted'));"
          ] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }], "url": "{{baseUrl}}/notifications" }
        },
        {
          "name": "Mark all notifications read",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }], "url": "{{baseUrl}}/notifications/read-all" }
        },
        {
          "name": "T7 View unknown request (404)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/requests/999999" }
        }
      ]
    },
    {
      "name": "3. Administration",
      "item": [
        {
          "name": "Dashboard statistics",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/stats" }
        },
        {
          "name": "Recent events",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/events" }
        },
        {
          "name": "List maintenance staff",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/users?role=maintenance" }
        },
        {
          "name": "Create a category",
          "event": [
            { "listen": "prerequest", "script": { "exec": ["pm.collectionVariables.set('newCategory', `Grounds ${Date.now() % 100000}`);"] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('newCategoryId', pm.response.json().category.id);"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/categories",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{newCategory}}\"\n}" }
          }
        },
        {
          "name": "Delete that category",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/categories/{{newCategoryId}}" }
        },
        {
          "name": "Admin deletes the request",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/requests/{{requestId}}" }
        }
      ]
    }
  ]
}
