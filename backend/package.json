{
  "name": "campusfix-backend",
  "version": "1.0.0",
  "description": "CampusFix REST API - event-driven maintenance request management for Sherubtse College (Node.js, Express, PostgreSQL)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:setup": "node src/db/setup.js",
    "db:reset": "node src/db/setup.js --reset",
    "db:setup:test": "node src/db/setup.js --test",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand tests/unit",
    "test:integration": "jest --runInBand tests/integration",
    "test:coverage": "jest --runInBand --coverage"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "express",
    "postgresql",
    "event-driven",
    "rest",
    "mvc",
    "sherubtse"
  ],
  "author": "07240005",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "backend": "^0.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "jest": "^25.1.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  }
}
